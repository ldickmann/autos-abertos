* text=auto eol=lf
# snapshots do portal e certificados: bytes exatos, nunca converter fim de linha
tests/fixtures/** -text
recon/certs/** -text
*.pem -text
*.crt binary
*.pdf binary
*.sqlite binary
# originais coletados e registros de coleta: bytes exatos (o sha256 depende disso), sem conversão de fim de linha
data/raw/** -text
data/raw/blobs/*.pdf binary
data/raw/blobs/*.rtf binary
# carimbos de tempo cobrem os bytes exatos destes arquivos
docs/carimbos/** -text
INTEGRIDADE.sha256 -text
